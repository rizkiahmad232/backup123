    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="factorialRizkiA, nilaiRizkiA" type="Integer" array="False" size=""/>
            <output expression="&quot;Hitung factorial &quot;" newline="True"/>
            <output expression="&quot;cantumkan nilai akhir&quot;" newline="True"/>
            <input variable="nilaiRizkiA"/>
            <for variable="factorialRizkiA" start="nilaiRizkiA" end="2" direction="dec" step="1">
                <assign variable="nilaiRizkiA" expression="nilaiRizkiA*factorialRizkiA"/>
            </for>
            <output expression="&quot;hasil factorial &quot;&amp;nilaiRizkiA" newline="True"/>
        </body>
    </function>
