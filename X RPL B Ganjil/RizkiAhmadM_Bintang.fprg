    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="bintangRizkiA, barisRizkiA, bintang1RizkiA" type="Integer" array="False" size=""/>
            <output expression="&quot;masukkan jumlah baris :&quot;" newline="True"/>
            <input variable="barisRizkiA"/>
            <for variable="bintangRizkiA" start="1" end="barisRizkiA" direction="inc" step="1">
                <for variable="bintang1RizkiA" start="1" end="bintangRizkiA" direction="inc" step="1">
                    <output expression="&quot;*&quot;" newline="False"/>
                </for>
                <output expression="&quot;&quot;" newline="True"/>
            </for>
        </body>
    </function>
