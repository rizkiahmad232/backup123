<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="RPL"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2024-10-15 09:19:41 PM"/>
        <attribute name="created" value="UlBMO1BDXzMxLVJQTF8yOzIwMjQtMTAtMTU7MDc6NTM6MDYgUE07MjI4OA=="/>
        <attribute name="edited" value="UlBMO1BDXzMxLVJQTF8yOzIwMjQtMTAtMTU7MDk6MTk6NDEgUE07MTsyMzk5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="belanjaRizkiA, hariRizkiA, totalRizkiA" type="Integer" array="False" size=""/>
            <assign variable="belanjaRizkiA" expression="50000"/>
            <assign variable="totalRizkiA" expression="belanjaRizkiA"/>
            <for variable="hariRizkiA" start="2" end="5" direction="inc" step="1">
                <assign variable="belanjaRizkiA" expression="belanjaRizkiA+10000"/>
                <assign variable="totalRizkiA" expression="belanjaRizkiA+totalRizkiA"/>
            </for>
            <output expression="totalRizkiA" newline="True"/>
        </body>
    </function>
</flowgorithm>
