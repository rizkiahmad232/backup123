    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="dikaliRAM, angkaPRAM, angkaHRAM" type="Integer" array="False" size=""/>
            <output expression="&quot;Masukan nilai perkalian&quot;" newline="True"/>
            <input variable="angkaPRAM"/>
            <output expression="&quot;Masukan jumlah yang akan dikalikan&quot;" newline="True"/>
            <input variable="angkaHRAM"/>
            <for variable="dikaliRAM" start="1" end="angkaHRAM" direction="inc" step="1">
                <output expression="angkaPRAM&amp;&quot;x&quot;&amp;dikaliRAM&amp; &quot;=&quot;&amp;angkaPRAM*dikaliRAM" newline="True"/>
            </for>
        </body>
    </function>
