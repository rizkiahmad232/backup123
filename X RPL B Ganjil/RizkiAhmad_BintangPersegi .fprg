    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="bintangRizkiA, barisRizkiA, bintang1RizkiA, cetakRizkiA" type="Integer" array="False" size=""/>
            <output expression="&quot;masukan bintang yang anda inginkan :&quot;" newline="True"/>
            <input variable="barisRizkiA"/>
            <output expression="&quot;masukan tinggi yang akan dicetak&quot;" newline="True"/>
            <input variable="cetakRizkiA"/>
            <for variable="bintangRizkiA" start="1" end="cetakRizkiA" direction="inc" step="1">
                <for variable="bintang1RizkiA" start="1" end="barisRizkiA" direction="inc" step="1">
                    <output expression="&quot;*&quot;" newline="False"/>
                </for>
                <output expression="&quot;&quot;" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
